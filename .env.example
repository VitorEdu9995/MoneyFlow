# ==============================================================================
# MoneyFlow - Variáveis de Ambiente & Integrações de Produção
# ==============================================================================

# Servidor HTTP Nativo
PORT=3001
NODE_ENV=production
# Chave de segurança para criptografia AES-256-GCM das chaves salvas no banco
APP_SECRET=moneyflow-segredo-de-criptografia-troque-em-producao

# ------------------------------------------------------------------------------
# Evolution API (Middleware de Mensagens do WhatsApp para Agentes de IA)
# ------------------------------------------------------------------------------
EVOLUTION_API_URL=https://evolution.seu-dominio.com.br
EVOLUTION_API_KEY=sua_api_key_da_evolution_api
EVOLUTION_INSTANCE_NAME=moneyflow

# ------------------------------------------------------------------------------
# Google Gemini API (Middleware de Áudio / TTS para Agentes de IA)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSy...
GEMINI_DEFAULT_VOICE=Charon
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
