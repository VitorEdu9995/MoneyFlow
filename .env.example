# ==============================================================================
# MoneyFlow - Exemplo de Variáveis de Ambiente (.env)
# ==============================================================================
# Copie este arquivo para .env na raiz do projeto:
#   cp .env.example .env (Linux/macOS) ou Copy-Item .env.example .env (Windows PowerShell)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIDOR HTTP E BANCO DE DADOS
# ------------------------------------------------------------------------------
# Ambiente de execução (production | development)
NODE_ENV=production

# Porta onde o servidor unificado (API REST + Servidor SPA Frontend) escutará
PORT=3001

# Caminho do arquivo SQLite (em Docker/VPS mapear para volume persistente)
DB_PATH=/app/.data/moneyflow.db

# Chave secreta mestra da aplicação (mínimo de 32 caracteres recomendados).
# Usada para derivação de chave AES-256-GCM com scrypt para cifrar segredos no banco.
APP_SECRET=sua-chave-mestra-ultra-secreta-com-pelo-menos-32-caracteres-aqui!

# ------------------------------------------------------------------------------
# 2. INTEGRAÇÃO GOOGLE GEMINI (SÍNTESE DE ÁUDIO TTS & IA)
# ------------------------------------------------------------------------------
# Chave de API do Google AI Studio (https://aistudio.google.com/app/apikey)
# Também pode ser informada pelo usuário na tela de Configurações (/settings) do frontend.
GEMINI_API_KEY=AIzaSyExemploDeChaveGeminiParaSinteseDeVoz12345

# Voz padrão do Gemini Text-to-Speech (Opções disponíveis: Charon, Aoede, Puck, Fenrir, Kore)
GEMINI_DEFAULT_VOICE=Charon

# Modelo do Google Gemini utilizado para síntese de áudio e tarefas cognitivas
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. INTEGRAÇÃO EVOLUTION API (WHATSAPP GATEWAY / MIDDLEWARE)
# ------------------------------------------------------------------------------
# URL base onde sua Evolution API v2 está hospedada (sem barra ao final)
EVOLUTION_API_URL=https://evolution.seudominio.com

# Chave de autenticação / Global API Key configurada na Evolution API
EVOLUTION_API_KEY=sua-evolution-global-api-key-aqui

# Nome da instância WhatsApp conectada na Evolution API
EVOLUTION_INSTANCE_NAME=moneyflow
